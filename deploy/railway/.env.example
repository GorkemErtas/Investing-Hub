NODE_ENV=production
# Docker defaults to 8080; the application also accepts Railway's injected PORT.
PORT=8080
# Replace with your exact public origin, without a trailing slash. Comma-separated.
CORS_ORIGINS=https://your-service.up.railway.app
# Only enable when the Railway edge is the sole public ingress (no TCP proxy).
TRUST_RAILWAY_PROXY=true
WEB_DIST_PATH=/app/webapp/dist
ML_DATABASE_PATH=/data/ml/lifecycle.sqlite3
PREDICTIONS_EXPORT_PATH=/data/ml/predictions.json
ML_DAILY_ENABLED=true
# Set a real shutdown grace period; the supervisor needs at most 12 seconds.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=20
FIREBASE_ENABLED=false
PRICE_ALERTS_ENABLED=false
# Public guest/demo mode requires no secrets. Optional account variables remain
# documented in backend/.env.example; configure secrets in Railway, never VITE_*.
# Verified registration: use Brevo HTTPS when outbound SMTP TCP ports time out.
# Requires the existing optional MONGO_URI and strong JWT_SECRET configuration.
# BREVO_API_KEY=your-private-brevo-api-key
# EMAIL_FROM=accounts@example.com
# EMAIL_FROM must be an authorized sender. Use a Brevo API key, not an SMTP key.
# Optional SMTP fallback only when BREVO_API_KEY is unset (still needs EMAIL_FROM).
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# Brevo takes precedence if both are set; provider errors return EMAIL_UNAVAILABLE.
