# No credentials required. Legacy .env files are NOT loaded automatically.
# Set process variables, or explicitly load a NEW, reviewed configuration file:
# node --env-file=.env.local backend/dist/backend/src/server.js
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_SECONDS=30
MARKET_STALE_SECONDS=900
