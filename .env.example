# Copy to .env.local for the Windows local launcher. No credentials are needed for guest mode.
NODE_ENV=development
PORT=5000
BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_SECONDS=30
MARKET_STALE_SECONDS=900

# Optional paths for the locally generated numeric prediction snapshot.
# PREDICTIONS_EXPORT_PATH=absolute-path-to-ml/data/predictions.json
# ML_DATABASE_PATH=absolute-path-to-the-same-lifecycle.sqlite3
# FORECASTS_EXPORT_PATH=absolute-path-to-ml/data/forecasts-v2.json
# OBJECTIVE_FORECASTS_EXPORT_PATH=absolute-path-to-ml/data/objective-forecasts.json

# Optional existing MongoDB Community Windows service or Atlas database.
# MONGO_URI=mongodb://127.0.0.1:27017/investing_hub
# JWT_SECRET=
# Generate a private random secret of at least 32 bytes; see docs/LOCAL_WINDOWS.md.
# Registration/email verification also needs the existing email settings; see backend/README.md.
# SMTP_URL=smtps://...
# EMAIL_FROM=...

# To run the API/web without Python or model artifacts:
# INVESTING_HUB_SKIP_ML=1
