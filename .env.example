# Public guest demo needs no credentials or database.
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_SECONDS=30
MARKET_STALE_SECONDS=900

# Optional news intelligence; credentials belong only in the backend environment.
NEWS_INTELLIGENCE_ENABLED=false
# See backend/.env.example and docs/NEWS_INTELLIGENCE.md for private setup.
