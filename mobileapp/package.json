{
  "name": "@investing-hub/mobile",
  "main": "./custom-entry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "npx expo-doctor",
    "config": "expo config --type public",
    "lint": "node ../node_modules/eslint/bin/eslint.js .",
    "eas-build-post-install": "npm --prefix .. ci --include=dev --ignore-scripts --workspace shared --include-workspace-root && npm --prefix .. run build -w shared",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@investing-hub/shared": "file:../shared",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-firebase/app": "^22.1.0",
    "@react-native-firebase/messaging": "^22.1.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.0.14",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "i18next": "^27.0.1",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^18.0.0",
    "react-native": "0.79.6",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "typescript": "^5.3.3",
    "vitest": "^4.0.0"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@investing-hub/shared"
        ]
      }
    }
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "postcss": "^8.5.32"
  }
}
