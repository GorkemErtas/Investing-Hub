NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_SECONDS=30
MARKET_STALE_SECONDS=900
# Optional mobile accounts. Leave unset for the public guest demo.
# MONGO_URI=mongodb://127.0.0.1:27017/authdb
# JWT_SECRET=generate-at-least-32-random-bytes-outside-source-control
# Optional verified registration (existing users can log in without SMTP).
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# EMAIL_FROM=accounts@example.com
# Optional price alerts, requires Firebase Application Default Credentials.
FIREBASE_ENABLED=false
PRICE_ALERTS_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=absolute-private-path-outside-repository

# Free news collection: no API key or paid subscription required.
NEWS_INTELLIGENCE_ENABLED=false
NEWS_GDELT_ENABLED=true
NEWS_GDELT_MIN_INTERVAL_MS=6000
NEWS_LOOKBACK_HOURS=336
# Official Lighthouse release metadata via the public GitHub API (no token).
NEWS_ETHEREUM_RELEASES_ENABLED=true
# Software releases are infrequent; publication dates stay visible.
NEWS_RELEASE_LOOKBACK_HOURS=720
# Ethereum site terms restrict automation; enable only after appropriate review/permission.
NEWS_ETHEREUM_RSS_ENABLED=false
# Independent, optional model-only AI analysis. Collection never invokes it.
NEWS_AI_ANALYSIS_ENABLED=false
# GEMINI_API_KEY must be newly issued; never reuse exposed legacy credentials.
# GEMINI_API_KEY=
GEMINI_KEY_ROTATED=false
GEMINI_MODEL=gemini-3.5-flash-lite
NEWS_CACHE_TTL_SECONDS=21600
NEWS_MAX_DAILY_REQUESTS=16
NEWS_MAX_DAILY_SOURCE_REQUESTS=48
NEWS_PROVIDER_TIMEOUT_MS=20000
NEWS_RETENTION_HOURS=72
# NEWS_STORAGE_PATH=absolute-local-persistent-directory-outside-OneDrive
