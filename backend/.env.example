NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_TIMEOUT_MS=5000
MARKET_CACHE_SECONDS=30
MARKET_STALE_SECONDS=900
# Optional mobile accounts. Leave unset for the public guest demo.
# MONGO_URI=mongodb://127.0.0.1:27017/authdb
# JWT_SECRET=generate-at-least-32-random-bytes-outside-source-control
# Optional verified registration (existing users can log in without SMTP).
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# EMAIL_FROM=accounts@example.com
# Optional price alerts, requires Firebase Application Default Credentials.
FIREBASE_ENABLED=false
PRICE_ALERTS_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=absolute-private-path-outside-repository

# Future Analysis: read-only ML publication; optional paid review is OFF.
# FUTURE_ML_EXPORT_PATH=absolute-path-to-ml/data/future-forecasts.json
# FUTURE_ML_DATABASE_PATH=absolute-path-to-the-same-lifecycle.sqlite3
FUTURE_GEMINI_SEARCH_ENABLED=false
# GEMINI_API_KEY=private-new-AQ.-auth-key
GEMINI_KEY_ROTATED=false
GEMINI_MODEL=gemini-3.5-flash-lite
FUTURE_REVIEW_TTL_SECONDS=900
FUTURE_CACHE_TTL_SECONDS=21600
FUTURE_STALE_SECONDS=86400
FUTURE_TIMEOUT_MS=30000
FUTURE_MAX_DAILY_REQUESTS=8
FUTURE_MAX_MONTHLY_REQUESTS=64
FUTURE_MAX_DAILY_ESTIMATED_USD=1
FUTURE_MAX_MONTHLY_ESTIMATED_USD=10
# FUTURE_STORAGE_PATH=private-persistent-accounting-directory-outside-OneDrive
# Only counters/diagnostics are stored here, never grounded reports.
